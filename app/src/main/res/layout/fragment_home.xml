<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_pad"
        android:paddingTop="@dimen/space_2xl"
        android:paddingBottom="120dp"
        android:clipToPadding="false">

        <!-- هدر مینیمال: فقط نام اپ + آیکون تنظیمات -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_app_name"
                style="@style/Text.irtax.Headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name" />

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="@dimen/icon_btn"
                android:layout_height="@dimen/icon_btn"
                android:background="@drawable/bg_icon_circle"
                android:contentDescription="@string/cd_open_settings"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_secondary" />

        </LinearLayout>

        <!-- Hero: ادامه مطالعه / شروع آزمون -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/hero_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:background="@drawable/bg_hero_card"
            app:cardBackgroundColor="@color/hero_gradient_start"
            app:cardCornerRadius="@dimen/radius_card_lg"
            app:cardElevation="12dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_2xl">

                <TextView
                    android:id="@+id/tv_hero_kicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_glass"
                    android:fontFamily="@font/vazirmatn_medium"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="@string/home_greeting"
                    android:textColor="@color/on_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_hero_title"
                    style="@style/Text.irtax.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:lineSpacingMultiplier="1.5"
                    android:textColor="@color/on_primary"
                    android:textSize="19sp"
                    tools:text="فصل دوم - تکالیف اشخاص مشمول" />

                <TextView
                    android:id="@+id/tv_hero_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:alpha="0.85"
                    android:fontFamily="@font/vazirmatn"
                    android:lineSpacingMultiplier="1.7"
                    android:textColor="@color/on_primary"
                    android:textSize="13sp"
                    tools:text="ماده ۵ از ۲۴ ماده" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_hero_cta"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:fontFamily="@font/vazirmatn_semibold"
                        android:paddingHorizontal="24dp"
                        android:text="@string/hero_cta"
                        android:textColor="@color/primary_deep"
                        android:textSize="14sp"
                        app:backgroundTint="@color/on_primary"
                        app:cornerRadius="@dimen/radius_pill"
                        app:icon="@drawable/ic_arrow_start"
                        app:iconGravity="textEnd"
                        app:iconTint="@color/primary_deep" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_hero_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.95"
                        android:fontFamily="@font/vazirmatn_semibold"
                        android:textColor="@color/on_primary"
                        android:textSize="22sp"
                        tools:text="۳۵٪" />

                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/hero_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    app:indicatorColor="@color/on_primary"
                    app:trackColor="#33FFFFFF"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="6dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- خلاصه آمار هوشمند: کارت‌های شیشه‌ای کوچک -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_doc"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/stat_articles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    tools:text="۲۴" />

                <TextView
                    style="@style/Text.irtax.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_articles" />

            </LinearLayout>

            <Space android:layout_width="12dp" android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check"
                    app:tint="@color/success" />

                <TextView
                    android:id="@+id/stat_read"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    tools:text="۸" />

                <TextView
                    style="@style/Text.irtax.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_read" />

            </LinearLayout>

            <Space android:layout_width="12dp" android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bookmark_filled"
                    app:tint="@color/warning" />

                <TextView
                    android:id="@+id/stat_favorites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    tools:text="۳" />

                <TextView
                    style="@style/Text.irtax.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_favorites" />

            </LinearLayout>

        </LinearLayout>

        <!-- پیشنهاد هوشمند -->
        <LinearLayout
            android:id="@+id/suggestion_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_glass_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_xl">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_warning">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bulb"
                    app:tint="@color/warning" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_lg"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.irtax.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_suggestion_title"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_suggestion_text"
                    style="@style/Text.irtax.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:text="فصل سوم را هنوز مرور نکرده‌ای" />

            </LinearLayout>

            <TextView
                android:id="@+id/btn_practice"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/space_md"
                android:background="@drawable/bg_pill_primary"
                android:fontFamily="@font/vazirmatn_semibold"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="@string/practice_now"
                android:textColor="@color/on_primary"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- دسترسی سریع -->
        <TextView
            style="@style/Text.irtax.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:text="@string/quick_access"
            android:textSize="16sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_chapters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="10dp"
                app:singleLine="true" />

        </HorizontalScrollView>

        <!-- Infographic: simplified invoice flow based on Article 5 -->
        <TextView
            style="@style/Text.irtax.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:text="@string/infographic_title"
            android:textSize="16sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:cardBackgroundColor="@color/surface_glass_strong"
            app:cardCornerRadius="@dimen/radius_card_lg"
            app:cardElevation="0dp"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/infographic_invoice_flow"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_circle_warning"
                            android:gravity="center"
                            android:text="۱"
                            android:textColor="@color/warning"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/infographic_step_seller"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_circle_warning"
                            android:gravity="center"
                            android:text="۲"
                            android:textColor="@color/warning"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/infographic_step_system"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_circle_warning"
                            android:gravity="center"
                            android:text="۳"
                            android:textColor="@color/warning"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/infographic_step_buyer"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/infographic_source_note"
                    android:textColor="@color/text_tertiary"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
