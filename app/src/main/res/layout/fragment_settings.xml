<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_pad"
        android:paddingTop="@dimen/space_2xl"
        android:paddingBottom="120dp">

        <TextView
            style="@style/Text.irtax.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title" />

        <!-- ===== ظاهر ===== -->
        <LinearLayout
            android:id="@+id/progress_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="@dimen/space_xl">

            <TextView
                style="@style/Text.irtax.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_appearance"
                android:textSize="15sp" />

            <TextView
                style="@style/Text.irtax.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/settings_dark_mode"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_dark_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_light"
                    style="@style/Widget.irtax.Segmented"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/dark_mode_light" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_dark"
                    style="@style/Widget.irtax.Segmented"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/dark_mode_dark" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_system"
                    style="@style/Widget.irtax.Segmented"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/dark_mode_system" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                style="@style/Text.irtax.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/settings_accent"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/swatch_indigo"
                    android:layout_width="56dp"
                    android:layout_height="56dp">

                    <View
                        android:id="@+id/swatch_indigo_inner"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_accent_swatch" />

                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_swatch_indigo" />

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/swatch_teal"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="@dimen/space_lg">

                    <View
                        android:id="@+id/swatch_teal_inner"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_accent_swatch" />

                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_swatch_teal" />

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/swatch_violet"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="@dimen/space_lg">

                    <View
                        android:id="@+id/swatch_violet_inner"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_accent_swatch" />

                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_swatch_violet" />

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ===== مطالعه ===== -->
        <LinearLayout
            android:id="@+id/reading_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="@dimen/space_xl">

            <TextView
                style="@style/Text.irtax.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_reading"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.irtax.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_font_size"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_font_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_container"
                    android:fontFamily="@font/vazirmatn_semibold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/on_primary_container"
                    android:textSize="13sp"
                    tools:text="۱۶" />

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_font"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                android:valueFrom="13"
                android:valueTo="22"
                app:labelBehavior="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.irtax.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_reduce_motion"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/Text.irtax.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_reduce_motion_desc" />

                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_reduce_motion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- بازنشانی -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_xl"
            android:fontFamily="@font/vazirmatn_semibold"
            android:text="@string/settings_reset"
            android:textColor="@color/danger" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
