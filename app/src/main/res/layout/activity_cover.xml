<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/cardContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_margin="16dp">

            <!-- Kicker -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="@drawable/bg_kicker">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" نسخه ۱۵ - ۱۴۰۴ "
                    android:textSize="14sp"
                    android:textColor="@color/colorAccent"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Title -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="قوانین جامع مالیاتی"
                    android:textSize="28sp"
                    android:textColor="@color/colorAccent"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="20dp" />
            </androidx.cardview.widget.CardView>

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="قانون پایانه فروشگاهی و سامانه مؤدیان"
                android:textSize="18sp"
                android:textColor="@color/colorAccent2"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="16dp"
                android:layout_marginTop="12dp" />

            <!-- Description -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/colorMuted"
                android:gravity="center"
                android:padding="12dp"
                android:background="@drawable/bg_description" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/colorLine"
                android:layout_marginVertical="20dp" />

            <!-- Preparer Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تهیه و تنظیم"
                    android:textSize="12sp"
                    android:textColor="@color/colorMuted" />

                <TextView
                    android:id="@+id/tvPreparerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="حسین جوادیان"
                    android:textSize="24sp"
                    android:textColor="@color/colorAccent"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvPreparerOffice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مجتمع حقوقی و مالیاتی جوادیان"
                    android:textSize="14sp"
                    android:textColor="@color/colorMuted"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Phone -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:padding="12dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_phone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📞"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="۰۹۱۲۲۸۵۲۳۴۰"
                    android:textSize="16sp"
                    android:textColor="@color/colorInk"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:textDirection="ltr"   
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Version -->
            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="نسخه ۱۵ - ۱۴۰۴"
                android:textSize="12sp"
                android:textColor="@color/colorMuted"
                android:layout_marginTop="16dp" />

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStart"
                    android:layout_width="200dp"
                    android:layout_height="56dp"
                    android:text="شروع مطالعه ←"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/colorAccent"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="⚙️ تنظیمات"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:strokeColor="@color/colorAccent"
                    android:textColor="@color/colorAccent"
                    app:cornerRadius="12dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
